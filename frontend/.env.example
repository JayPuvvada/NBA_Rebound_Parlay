# Copy to .env.local and fill in values from Supabase's Connect dialog.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable after the public-signup migration and matching Supabase Auth settings.
# For verified signup, configure custom SMTP and callback handling first.
VITE_PUBLIC_SIGNUP=false
# Only publishable (sb_publishable_...) or legacy anon keys belong here.
# NEVER put a database password, secret key or service-role key in VITE_ variables.
