# Optional: enables live sportsbook lines in Daily Edge.
ODDS_API_KEY=

# Quotes older than this many seconds are displayed as diagnostic-only.
ODDS_MAX_AGE_SECONDS=300

# Optional: authenticated HTTP(S) proxy used only for stats.nba.com requests.
# Example: http://username:password@proxy-host:port
NBA_API_PROXY=

# Comma-separated browser origins allowed to call the API during development.
# Production requests are same-origin and do not require a CORS entry.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

LOG_LEVEL=INFO
MODEL_VERSION=2.0.0
PREDICTIONS_DB_PATH=data/predictions.db

# Required before the web API can write issued picks to the ledger. Generate a
# long random value and enter the same value in Player Lookup when saving.
LEDGER_WRITE_TOKEN=

# Per-client, per-minute process-local safeguards. Set a value to 0 to disable.
PREDICT_RATE_LIMIT=20
GAMES_RATE_LIMIT=60
CHEAT_SHEET_RATE_LIMIT=8

# Gunicorn defaults used by Procfile.
WEB_CONCURRENCY=1
WEB_THREADS=4
WEB_TIMEOUT=180
